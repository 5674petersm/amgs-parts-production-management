{
  "name": "amgs-parts-production-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:logs": "pm2 logs amgs-production",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); try{require('fs').rmSync('node_modules/.cache',{recursive:true,force:true})}catch(e){}\"",
    "test": "node --experimental-default-type=module --test test/*.test.mjs"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "googleapis": "^173.0.0",
    "html5-qrcode": "^2.3.8",
    "mssql": "^11.0.1",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.28",
    "occt-import-js": "^0.0.23",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pdfkit": "^0.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svg-to-pdfkit": "^0.1.8",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@types/three": "^0.184.1",
    "typescript": "^5.8.3"
  }
}
